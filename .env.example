# Leave BOTH blank for Local teams and anonymous D1 Snapshot sharing.
# Supply BOTH for optional Supabase accounts and Cloud Sync.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret: optional-email registration, login-code resolution and password-confirmed account deletion.
# Configure as a Worker secret in production. NEVER prefix with NEXT_PUBLIC_ or VITE_.
SUPABASE_SERVICE_ROLE_KEY=

